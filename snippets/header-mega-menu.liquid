{% comment %}
  Renders a premium visual megamenu for the header driven dynamically by store collections.
  Usage:
  {% render 'header-mega-menu' %}
{% endcomment %}

<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    
    <!-- 1. NEW ARRIVALS -->
    <li>
      <a href="/collections/all" class="header__menu-item list-menu__item link link--text focus-inset">
        <span>NEW ARRIVALS</span>
      </a>
    </li>

    <!-- 2. ETHNIC WEAR Dropdown -->
    <li>
      <header-menu>
        <details id="Details-HeaderMenu-EthnicWear" class="mega-menu">
          <summary class="header__menu-item list-menu__item link focus-inset">
            <span>ETHNIC WEAR</span>
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </summary>
          <div
            id="MegaMenu-Content-EthnicWear"
            class="mega-menu__content color-{{ section.settings.menu_color_scheme }} gradient motion-reduce global-settings-popup"
            tabindex="-1"
          >
            <ul class="mega-menu__list page-width" role="list">
              {%- for collection in collections -%}
                {%- unless collection.handle == 'frontpage' or collection.handle == 'all' -%}
                  <li>
                    <a href="{{ collection.url }}" class="mega-menu__link mega-menu__link--level-2 link">
                      {{ collection.title | escape }}
                    </a>
                  </li>
                {%- endunless -%}
              {%- endfor -%}
            </ul>
          </div>
        </details>
      </header-menu>
    </li>

    <!-- 3. CHANIYA CHOLI -->
    <li>
      <a href="/collections/chaniya-choli" class="header__menu-item list-menu__item link link--text focus-inset">
        <span>CHANIYA CHOLI</span>
      </a>
    </li>

    <!-- 4. PREMIUM COLLECTION -->
    <li>
      <header-menu>
        <details id="Details-HeaderMenu-PremiumCollection" class="mega-menu">
          <summary class="header__menu-item list-menu__item link focus-inset">
            <span>PREMIUM COLLECTION</span>
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </summary>
          <div
            id="MegaMenu-Content-PremiumCollection"
            class="mega-menu__content color-{{ section.settings.menu_color_scheme }} gradient motion-reduce global-settings-popup"
            tabindex="-1"
          >
            <div class="mega-menu__grid-container">
              
              <!-- Collections List Columns on Left -->
              <div class="mega-menu__grid-links">
                <ul class="mega-menu__list" role="list" style="width: 100%; max-width: 100%; padding: 0;">
                  {%- for collection in collections -%}
                    {%- unless collection.handle == 'frontpage' or collection.handle == 'all' -%}
                      <li>
                        <a href="{{ collection.url }}" class="mega-menu__link mega-menu__link--level-2 link">
                          {{ collection.title | escape }}
                        </a>
                      </li>
                    {%- endunless -%}
                  {%- endfor -%}
                </ul>
              </div>
              
              <!-- Visual Promo Advertisements on Right -->
              <div class="mega-menu__promos">
                
                <!-- Promo 1 Card -->
                <div class="mega-menu__promo-card" onclick="window.location.href='{{ section.settings.promo_1_link | default: '#' }}'">
                  <div class="mega-menu__promo-img-wrapper">
                    {%- if section.settings.promo_1_image != blank -%}
                      {{ section.settings.promo_1_image | image_url: width: 400 | image_tag: 
                        class: 'mega-menu__promo-img',
                        loading: 'lazy',
                        alt: section.settings.promo_1_title
                      }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg mega-menu__promo-img' }}
                    {%- endif -%}
                  </div>
                  <div class="mega-menu__promo-overlay"></div>
                  <div class="mega-menu__promo-content">
                    {%- if section.settings.promo_1_badge != blank -%}
                      <span class="mega-menu__promo-badge">{{ section.settings.promo_1_badge }}</span>
                    {%- endif -%}
                    {%- if section.settings.promo_1_title != blank -%}
                      <h4 class="mega-menu__promo-title">{{ section.settings.promo_1_title }}</h4>
                    {%- endif -%}
                    <span class="mega-menu__promo-link">
                      {{ section.settings.promo_1_link_label | default: "Shop Collection" }}
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
                      </svg>
                    </span>
                  </div>
                </div>

                <!-- Promo 2 Card -->
                <div class="mega-menu__promo-card" onclick="window.location.href='{{ section.settings.promo_2_link | default: '#' }}'">
                  <div class="mega-menu__promo-img-wrapper">
                    {%- if section.settings.promo_2_image != blank -%}
                      {{ section.settings.promo_2_image | image_url: width: 400 | image_tag: 
                        class: 'mega-menu__promo-img',
                        loading: 'lazy',
                        alt: section.settings.promo_2_title
                      }}
                    {%- else -%}
                      {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg mega-menu__promo-img' }}
                    {%- endif -%}
                  </div>
                  <div class="mega-menu__promo-overlay"></div>
                  <div class="mega-menu__promo-content">
                    {%- if section.settings.promo_2_badge != blank -%}
                      <span class="mega-menu__promo-badge">{{ section.settings.promo_2_badge }}</span>
                    {%- endif -%}
                    {%- if section.settings.promo_2_title != blank -%}
                      <h4 class="mega-menu__promo-title">{{ section.settings.promo_2_title }}</h4>
                    {%- endif -%}
                    <span class="mega-menu__promo-link">
                      {{ section.settings.promo_2_link_label | default: "Discover Luxury" }}
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
                      </svg>
                    </span>
                  </div>
                </div>

              </div> <!-- end mega-menu__promos -->
              
            </div> <!-- end mega-menu__grid-container -->
          </div>
        </details>
      </header-menu>
    </li>

    <!-- 5. SALE -->
    <li>
      <a href="/collections/all" class="header__menu-item list-menu__item link link--text focus-inset" style="color: #b32b39 !important;">
        <span style="color: #b32b39 !important; font-weight: 600;">SALE</span>
      </a>
    </li>

  </ul>
</nav>
