<div class="premium-hero color-{{ section.settings.color_scheme }} gradient">
  <!-- Decorative background elements -->
  {%- if section.settings.show_background_pattern -%}
    <div class="premium-hero__bg-grid"></div>
    <div class="premium-hero__bg-glow"></div>
  {%- endif -%}

  <div class="page-width">
    <div class="premium-hero__grid" style="{% if section.settings.layout_alignment == 'right' %}direction: rtl;{% endif %}">
      
      <!-- Content Block -->
      <div class="premium-hero__content" style="direction: ltr;">
        {%- if section.settings.badge_text != blank -%}
          <div class="premium-hero__badge animate--slide-in">
            <span class="premium-hero__badge-dot"></span>
            <span>{{ section.settings.badge_text }}</span>
          </div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="premium-hero__title animate--slide-in">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="premium-hero__description animate--slide-in">
            <p>{{ section.settings.description }}</p>
          </div>
        {%- endif -%}

        <div class="premium-hero__buttons animate--slide-in">
          {%- if section.settings.button_1_label != blank -%}
            <a href="{{ section.settings.button_1_link }}" class="button button--primary button-glow-effect">
              {{ section.settings.button_1_label }}
            </a>
          {%- endif -%}
          {%- if section.settings.button_2_label != blank -%}
            <a href="{{ section.settings.button_2_link }}" class="button button--secondary">
              {{ section.settings.button_2_label }}
            </a>
          {%- endif -%}
        </div>
      </div>

      <!-- Visual Showcase -->
      <div class="premium-hero__visual" style="direction: ltr;">
        <div class="premium-hero__main-image-wrapper">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1000 | image_tag: 
              class: 'premium-hero__main-image',
              loading: 'eager',
              alt: section.settings.image.alt | default: section.settings.heading
            }}
          {%- else -%}
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg premium-hero__main-image' }}
          {%- endif -%}
        </div>

        <!-- Floating Card 1 (Rating or Stats) -->
        {%- if section.settings.floating_card_1_title != blank -%}
          <div class="premium-hero__floating-card premium-hero__floating-card--1">
            <div class="premium-hero__floating-card-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
              </svg>
            </div>
            <div class="premium-hero__floating-card-text">
              <span class="premium-hero__floating-card-title">{{ section.settings.floating_card_1_title }}</span>
              <span class="premium-hero__floating-card-subtitle">{{ section.settings.floating_card_1_subtitle }}</span>
            </div>
          </div>
        {%- endif -%}

        <!-- Floating Card 2 (Exclusivity or Speed) -->
        {%- if section.settings.floating_card_2_title != blank -%}
          <div class="premium-hero__floating-card premium-hero__floating-card--2">
            <div class="premium-hero__floating-card-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </div>
            <div class="premium-hero__floating-card-text">
              <span class="premium-hero__floating-card-title">{{ section.settings.floating_card_2_title }}</span>
              <span class="premium-hero__floating-card-subtitle">{{ section.settings.floating_card_2_subtitle }}</span>
            </div>
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Premium Interactive Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_background_pattern",
      "label": "Show Background Decorative Glow & Grid",
      "default": true
    },
    {
      "type": "select",
      "id": "layout_alignment",
      "label": "Desktop Visual Layout Style",
      "options": [
        {
          "value": "left",
          "label": "Image on Right"
        },
        {
          "value": "right",
          "label": "Image on Left"
        }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Showcase Image"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Top Badge Text",
      "default": "NEW LUXURY ARRIVALS"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Hero Title",
      "default": "Crafting the Future of <span class='premium-serif-text'>Elegant Living</span>"
    },
    {
      "type": "inline_richtext",
      "id": "description",
      "label": "Hero Description",
      "default": "Discover curated collections crafted by master designers, engineered with timeless elegance to transform your lifestyle."
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Primary Button Text",
      "default": "EXPLORE NOW"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Primary Button Link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary Button Text",
      "default": "VIEW COLLECTIONS"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary Button Link",
      "default": "/collections"
    },
    {
      "type": "header",
      "content": "Floating Decorative Card 1"
    },
    {
      "type": "text",
      "id": "floating_card_1_title",
      "label": "Card 1 Title",
      "default": "4.9★ RATED STORE"
    },
    {
      "type": "text",
      "id": "floating_card_1_subtitle",
      "label": "Card 1 Subtitle",
      "default": "By 12,000+ Happy Clients"
    },
    {
      "type": "header",
      "content": "Floating Decorative Card 2"
    },
    {
      "type": "text",
      "id": "floating_card_2_title",
      "label": "Card 2 Title",
      "default": "100% SECURE CHECKOUT"
    },
    {
      "type": "text",
      "id": "floating_card_2_subtitle",
      "label": "Card 2 Subtitle",
      "default": "Shop with Peace of Mind"
    }
  ],
  "presets": [
    {
      "name": "Premium Interactive Hero"
    }
  ]
}
{% endschema %}
