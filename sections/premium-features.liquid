<div class="premium-features color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    
    {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
      <div class="section-heading text-center" style="margin-bottom: 5rem; text-align: center;">
        {%- if section.settings.subtitle != blank -%}
          <span class="premium-hero__badge" style="margin-bottom: 1.5rem;">
            <span class="premium-hero__badge-dot"></span>
            <span>{{ section.settings.subtitle }}</span>
          </span>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="h1" style="margin-top: 0;">{{ section.settings.title }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="premium-features__grid" style="grid-template-columns: repeat(1, 1fr);">
      {%- style -%}
        @media screen and (min-width: 600px) {
          .premium-features__grid {
            grid-template-columns: repeat(2, 1fr) !important;
          }
        }
        @media screen and (min-width: 990px) {
          .premium-features__grid {
            grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr) !important;
          }
        }
      {%- endstyle -%}

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'premium_feature_card' -%}
            <div class="premium-features__card animate--slide-in" {{ block.shopify_attributes }}>
              <div class="premium-features__icon-wrapper">
                {%- case block.settings.icon -%}
                  {%- when 'truck' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v11.177m0-11.177a9.75 9.75 0 113.336 4.8M15 9.75a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                  {%- when 'award' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.563.563 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
                    </svg>
                  {%- when 'shield' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751A11.956 11.956 0 0112 2.714z" />
                    </svg>
                  {%- when 'heart' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                    </svg>
                  {%- when 'leaf' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18m0-18h-.01m.01 0c.269 0 .53.037.78.106a11.933 11.933 0 017.632 7.631c.07.25.107.512.107.781v.01H12m0-8.529V21m0-18c-.27 0-.531.037-.781.106a11.933 11.933 0 00-7.632 7.631C3.51 10.989 3.472 11.25 3.472 11.52v.01H12" />
                    </svg>
                  {%- when 'support' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 9.75v-4.5m0 4.5h4.5m-4.5 0l6-6m-3 18c-4.97 0-9-4.03-9-9s4.03-9 9-9 9 4.03 9 9-4.03 9-9 9z" />
                    </svg>
                {%- endcase -%}
              </div>
              <h3 class="premium-features__title">{{ block.settings.title }}</h3>
              <p class="premium-features__description">{{ block.settings.description }}</p>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Premium Brand Features",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Small Subtitle",
      "default": "OUR CORE VALUABLES"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "Why Shopping With Us Feels Different"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4,
      "label": "Columns on Desktop"
    }
  ],
  "blocks": [
    {
      "type": "premium_feature_card",
      "name": "Feature Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Select Feature Icon",
          "options": [
            {
              "value": "truck",
              "label": "Free Shipping (Truck)"
            },
            {
              "value": "award",
              "label": "Premium Quality (Star/Award)"
            },
            {
              "value": "shield",
              "label": "Secure Payments (Shield)"
            },
            {
              "value": "heart",
              "label": "Loved by Customers (Heart)"
            },
            {
              "value": "leaf",
              "label": "Eco-Conscious (Leaf)"
            },
            {
              "value": "support",
              "label": "24/7 Support (Lifebuoy/Support)"
            }
          ],
          "default": "award"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Feature Title",
          "default": "Timeless Handcrafting"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Feature Description",
          "default": "Every single piece in our store is meticulously finished by master artisans who pour lifetime expertise into details."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Premium Brand Features",
      "blocks": [
        {
          "type": "premium_feature_card",
          "settings": {
            "icon": "truck",
            "title": "Complimentary Delivery",
            "description": "Receive free signature packaging and premium white-glove home delivery across all domestic orders."
          }
        },
        {
          "type": "premium_feature_card",
          "settings": {
            "icon": "award",
            "title": "Heritage Craftsmanship",
            "description": "Each item comes with a certified warranty of premium, ethically sourced, artisanal grade components."
          }
        },
        {
          "type": "premium_feature_card",
          "settings": {
            "icon": "shield",
            "title": "Secure Encrypted Pay",
            "description": "Your checkout transaction is shielded by state-of-the-art 256-bit cryptographic SSL protocol."
          }
        },
        {
          "type": "premium_feature_card",
          "settings": {
            "icon": "leaf",
            "title": "Sustainably Minded",
            "description": "We dedicate 1% of net profits directly towards restoring native habitats and planting healthy woodlands."
          }
        }
      ]
    }
  ]
}
{% endschema %}
